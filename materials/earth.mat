material {
  name : KtxEarthVulkan,
  shadingModel : unlit,
  requires : [
    custom0
  ],
  variables : [
    { name : lookupNormal, precision : medium }
  ],
  parameters : [
    { type : samplerCubemap, format : float, precision : medium, name : dayMap },
    { type : samplerCubemap, format : float, precision : medium, name : nightMap },
    { type : samplerCubemap, format : float, precision : medium, name : cloudMaskMap },
    { type : float3, name : sunDirection },
    { type : float3, name : userLocation },
    { type : float, name : time },
    { type : float, name : auroraActivity }
  ],
  variantFilter : [
    directionalLighting,
    dynamicLighting,
    shadowReceiver,
    skinning,
    fog,
    vsm,
    ssr,
    stereo
  ]
}

vertex {
  void materialVertex(inout MaterialVertexInputs material) {
    material.lookupNormal = getCustom0();
  }
}

fragment {
  const float cloudIntensityDay = 0.50;
  const float cloudShadowIntensity = 0.40;
  const float cloudShadowHeight = 0.00733038;
  const float cloudMaskBoost = 0.82;
  const float cloudThinBoostMix = 0.38;
  const float daySharpenAmount = 0.28;
  const float daySharpenOffset = 0.0016;

  float3 tangentForNormal(float3 normal) {
    return normalize(cross(normal, float3(0.0, 1.0, 0.0)) + float3(0.0001, 0.0, 0.0));
  }

  float3 sampleDayTexture(float3 normal) {
    return texture(materialParams_dayMap, normalize(normal)).rgb;
  }

  float3 sampleNightTexture(float3 normal) {
    return texture(materialParams_nightMap, normalize(normal)).rgb;
  }

  float sampleCloudMaskTexture(float3 normal) {
    return texture(materialParams_cloudMaskMap, normalize(normal)).r;
  }

  float3 sampleDaySharp(float3 normal) {
    float3 n = normalize(normal);
    float3 tangent = tangentForNormal(n);
    float3 bitangent = cross(n, tangent);
    float3 center = sampleDayTexture(n);
    float3 blur = sampleDayTexture(n + tangent * daySharpenOffset);
    blur += sampleDayTexture(n - tangent * daySharpenOffset);
    blur += sampleDayTexture(n + bitangent * daySharpenOffset);
    blur += sampleDayTexture(n - bitangent * daySharpenOffset);
    blur *= 0.25;
    return clamp(center + (center - blur) * daySharpenAmount, 0.0, 1.0);
  }

  float boostThinCloudMask(float mask) {
    return mix(mask, sqrt(mask), cloudThinBoostMix);
  }

  float3 cloudLookupTransform(float3 normal) {
    return normalize(float3(normal.z, normal.x, normal.y));
  }

  void material(inout MaterialInputs material) {
    prepareMaterial(material);

    float3 lookup = normalize(variable_lookupNormal.xyz);
    float3 cloudLookup = cloudLookupTransform(lookup);
    float3 eyeVector = normalize(getWorldViewVector());
    float3 worldNormal = normalize(getWorldPosition());
    float3 lightVector = normalize(materialParams.sunDirection);
    float eyeLight = abs(dot(worldNormal, eyeVector));
    float lightDirection = dot(lookup, lightVector);
    float inverseLightDirection = 1.0 - lightDirection;
    float3 cloudLightVector = cloudLookupTransform(lightVector);
    float3 tangentLight = cloudLightVector - cloudLookup * dot(cloudLookup, cloudLightVector);
    float tangentLightLength = length(tangentLight);
    float3 shadowLookup =
      tangentLightLength > 0.0001
        ? normalize(cloudLookup + tangentLight / tangentLightLength * cloudShadowHeight)
        : cloudLookup;
    float cloudShadowDensity =
      boostThinCloudMask(sampleCloudMaskTexture(shadowLookup)) * cloudMaskBoost;
    float cloudShadowCoverage = smoothstep(0.14, 0.90, cloudShadowDensity);

    float daylight = smoothstep(-0.12, 0.30, lightDirection);
    float night = 1.0 - smoothstep(-0.14, 0.22, lightDirection);
    float dayShade = 0.18 + max(lightDirection, 0.0) * 0.96;
    float3 daySurface = sampleDaySharp(lookup) * dayShade;
    daySurface *= 1.0 - cloudShadowCoverage * cloudIntensityDay * cloudShadowIntensity;

    float3 nightSurface = sampleNightTexture(lookup);
    float nightRim = smoothstep(0.0, 0.8, 1.0 - eyeLight);
    nightSurface -= nightRim * 0.05;
    nightSurface *= smoothstep(0.0, 1.0, eyeLight);
    nightSurface *= 0.82 + night * 0.18;

    float limbNight = smoothstep(0.48, 0.95, 1.0 - eyeLight) * smoothstep(0.20, 0.95, inverseLightDirection);
    float nightMix = max(1.0 - daylight, limbNight * 0.42);
    float3 base = mix(daySurface, nightSurface, nightMix);

    float sunsetAlpha = smoothstep(0.62, 1.08, inverseLightDirection) * smoothstep(-0.35, 0.25, lightDirection);
    float3 sunsetColor = mix(float3(0.93, 0.27, 0.06), float3(0.39, 0.44, 0.50), eyeLight);
    base = mix(base, base * sunsetColor, sunsetAlpha * 0.36);

    float3 reflectedLight = normalize(reflect(-lightVector, lookup));
    float specular = smoothstep(0.72, 1.10, dot(reflectedLight, eyeVector)) * 0.22;
    specular *= 1.0 - cloudShadowCoverage * 0.70;
    specular *= smoothstep(-1.5, 1.0, daySurface.b - daySurface.r - daySurface.g);
    base += float3(1.0, 0.72, 0.52) * specular * max(lightDirection, 0.0);

    float edgeGlow = 1.0 - eyeLight;
    edgeGlow = smoothstep(0.12, 1.0, edgeGlow);
    edgeGlow *= 1.0 - smoothstep(0.80, 0.90, edgeGlow);
    edgeGlow *= max(lightDirection, 0.0);
    float edgeMix = smoothstep(0.1, 0.38, eyeLight);
    float3 atmosphere = mix(float3(0.38, 0.69, 0.95), float3(0.68, 0.82, 0.94), edgeMix);
    float atmosphereOverCloud = 1.0 - cloudShadowCoverage * 0.72;
    base = mix(base, atmosphere, edgeGlow * 0.55 * atmosphereOverCloud);

    // Aurora: an animated curtain around the auroral oval on the night side. The
    // oval sits near 66 deg latitude and expands toward the equator as activity
    // (from the real planetary Kp index) rises. Gated on the (cheap) night factor
    // so the day hemisphere skips the transcendental band/shimmer math entirely.
    float auroraNight = smoothstep(0.06, -0.18, lightDirection);
    if (auroraNight > 0.001) {
      float auroraLatitude = asin(clamp(lookup.y, -1.0, 1.0));
      float auroraBandCenter = 1.22 - materialParams.auroraActivity * 0.28;
      float auroraBand = exp(-pow((abs(auroraLatitude) - auroraBandCenter) / 0.16, 2.0));
      float auroraLongitude = atan(lookup.x, lookup.z);
      float auroraShimmer =
        0.5 + 0.5 * sin(auroraLongitude * 8.0 + materialParams.time * 1.5)
        + 0.3 * sin(auroraLongitude * 17.0 - materialParams.time * 0.9);
      auroraShimmer = clamp(auroraShimmer, 0.0, 1.0);
      float auroraAmount =
        auroraBand * auroraNight * clamp(materialParams.auroraActivity, 0.0, 1.0) *
        (0.35 + 0.65 * auroraShimmer);
      float3 auroraColor =
        mix(float3(0.15, 0.95, 0.45), float3(0.35, 0.55, 1.0), smoothstep(1.0, 1.35, abs(auroraLatitude)));
      base += auroraColor * auroraAmount * 0.7;
    }

    // "You are here" marker: a solid dot plus an expanding, fading sonar ping at
    // the user's location (mesh-local direction). Gated on a cheap dot product so
    // only fragments near the location run acos / the ping animation.
    float locationDot = dot(lookup, normalize(materialParams.userLocation));
    if (locationDot > 0.98) {
      float locationAngle = acos(clamp(locationDot, -1.0, 1.0));
      float ping = fract(materialParams.time * 0.5);
      float pingRing = smoothstep(0.010, 0.0, abs(locationAngle - ping * 0.11)) * (1.0 - ping);
      float markerCore = smoothstep(0.020, 0.006, locationAngle);
      float marker = clamp(markerCore + pingRing, 0.0, 1.0);
      base = mix(base, float3(0.25, 0.95, 1.0), marker * 0.9);
    }

    material.baseColor = float4(clamp(base, 0.0, 1.0), 1.0);
  }
}
