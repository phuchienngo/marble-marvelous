material {
  name : FilamentCloudShell,
  shadingModel : unlit,
  requires : [
    custom0
  ],
  variables : [
    { name : lookupNormal, precision : medium }
  ],
  parameters : [
    { type : samplerCubemap, format : float, precision : medium, name : cloudMaskMap },
    { type : samplerCubemap, format : float, precision : medium, name : cloudDetailMap },
    { type : float3, name : sunDirection }
  ],
  blending : transparent,
  culling : back,
  depthWrite : false,
  depthCulling : true,
  variantFilter : [
    directionalLighting,
    dynamicLighting,
    shadowReceiver,
    skinning,
    fog,
    vsm,
    ssr,
    stereo
  ]
}

vertex {
  void materialVertex(inout MaterialVertexInputs material) {
    float3 lookup = normalize(getCustom0().xyz);
    material.worldPosition.xyz += normalize(material.worldPosition.xyz) * 0.0042;
    material.lookupNormal = float4(lookup, 1.0);
  }
}

fragment {
  const float cloudMaskSampleOffset = 0.0070;
  const float cloudDetailSampleOffset = 0.0050;
  const float cloudShadowHeight = 0.00733038;
  const float cloudReliefScale = 4.2;
  const float cloudDetailReliefMix = 0.11;
  const float cloudMaskBoost = 0.90;
  const float cloudThinBoostMix = 0.20;
  const float cloudSelfShadowStrength = 0.30;

  float3 tangentForNormal(float3 normal) {
    return normalize(cross(normal, float3(0.0, 1.0, 0.0)) + float3(0.0001, 0.0, 0.0));
  }

  float sampleCloudMask(float3 normal) {
    return texture(materialParams_cloudMaskMap, normalize(normal)).r;
  }

  float sampleCloudDetail(float3 normal) {
    return texture(materialParams_cloudDetailMap, normalize(normal)).r;
  }

  float boostThinCloudMask(float mask) {
    return mix(mask, sqrt(mask), cloudThinBoostMix);
  }

  float3 cloudLookupTransform(float3 normal) {
    return normalize(float3(normal.z, normal.x, normal.y));
  }

  void material(inout MaterialInputs material) {
    prepareMaterial(material);

    float3 lookup = normalize(variable_lookupNormal.xyz);
    float3 cloudLookup = cloudLookupTransform(lookup);
    float3 lightVector = normalize(materialParams.sunDirection);
    float3 cloudLightVector = cloudLookupTransform(lightVector);
    float lightDirection = dot(lookup, lightVector);
    float3 cloudTangent = tangentForNormal(cloudLookup);
    float3 cloudBitangent = cross(cloudLookup, cloudTangent);
    float3 tangentLight = cloudLightVector - cloudLookup * dot(cloudLookup, cloudLightVector);
    float tangentLightLength = length(tangentLight);
    float3 shadowLookup =
      tangentLightLength > 0.0001
        ? normalize(cloudLookup + tangentLight / tangentLightLength * cloudShadowHeight)
        : cloudLookup;

    float weatherMask = sampleCloudMask(cloudLookup);
    float maskPositiveTangent = sampleCloudMask(cloudLookup + cloudTangent * cloudMaskSampleOffset);
    float maskNegativeTangent = sampleCloudMask(cloudLookup - cloudTangent * cloudMaskSampleOffset);
    float maskPositiveBitangent = sampleCloudMask(cloudLookup + cloudBitangent * cloudMaskSampleOffset);
    float maskNegativeBitangent = sampleCloudMask(cloudLookup - cloudBitangent * cloudMaskSampleOffset);
    float maskBlur =
      (maskPositiveTangent + maskNegativeTangent + maskPositiveBitangent + maskNegativeBitangent) * 0.25;
    float featheredWeatherMask = mix(weatherMask, maskBlur, 0.34);
    float weatherShadowMask = sampleCloudMask(shadowLookup);
    float boostedWeatherMask = boostThinCloudMask(featheredWeatherMask);
    float boostedWeatherShadowMask = boostThinCloudMask(weatherShadowMask);

    float detailCenter = sampleCloudDetail(cloudLookup);
    float detailPositiveTangent =
      sampleCloudDetail(cloudLookup + cloudTangent * cloudDetailSampleOffset);
    float detailPositiveBitangent =
      sampleCloudDetail(cloudLookup + cloudBitangent * cloudDetailSampleOffset);
    float detailDome = smoothstep(0.12, 0.88, detailCenter);
    float fineModulation = mix(0.94, 1.04, smoothstep(0.10, 0.90, detailCenter));
    float cloudDensity = boostedWeatherMask * fineModulation * cloudMaskBoost;
    float cloudShadowDensity = boostedWeatherShadowMask * fineModulation * cloudMaskBoost;
    float cloudCoverage = smoothstep(0.13, 0.92, cloudDensity);
    float cloudCore = smoothstep(0.30, 0.86, cloudCoverage);
    float maskPeak = clamp((weatherMask - maskBlur) * 1.7 + 0.5, 0.0, 1.0);
    float baseHeight = smoothstep(0.12, 0.90, cloudDensity);
    float puffHeight =
      clamp(
        baseHeight * 0.90 +
          (maskPeak - 0.5) * cloudCore * 0.18 +
          (detailDome - 0.5) * cloudCore * 0.12,
        0.0,
        1.0
      );
    float cavity =
      clamp((maskBlur - weatherMask) * 0.90, 0.0, 1.0) * cloudCore;
    float selfShadow =
      clamp(
        (cloudShadowDensity - cloudDensity) * 1.20 + cavity * 0.26,
        0.0,
        1.0
      );

    float2 maskGradient =
      float2(
        maskPositiveTangent - maskNegativeTangent,
        maskPositiveBitangent - maskNegativeBitangent
      );
    float2 detailGradient =
      float2(
        detailPositiveTangent - detailCenter,
        detailPositiveBitangent - detailCenter
      );
    float2 cloudGradient =
      maskGradient + detailGradient * cloudCore * cloudDetailReliefMix;
    float3 cloudNormal =
      normalize(
        cloudLookup - cloudTangent * cloudGradient.x * cloudReliefScale -
          cloudBitangent * cloudGradient.y * cloudReliefScale
      );
    float directionalLight =
      (0.62 + 0.38 * smoothstep(-0.20, 0.85, dot(cloudNormal, cloudLightVector))) *
      (1.0 - selfShadow * cloudSelfShadowStrength);
    float interiorRelief =
      mix(0.82, 1.10, puffHeight) *
      mix(0.93, 1.10, detailDome) *
      (1.0 - cavity * 0.12);

    float dayFactor = smoothstep(-0.18, 0.28, lightDirection);
    float opacityRelief = mix(0.42, 0.86, smoothstep(0.10, 0.90, puffHeight));
    float dayOpacity = 0.58 * cloudCoverage * opacityRelief;
    float nightOpacity = 0.28 * cloudCoverage * mix(0.42, 0.78, opacityRelief);
    float opacity = mix(nightOpacity, dayOpacity, dayFactor);
    float3 dayColor =
      mix(
        float3(0.72, 0.76, 0.82),
        float3(0.99, 0.995, 1.0),
        smoothstep(0.12, 0.92, puffHeight)
      );
    dayColor *= directionalLight * interiorRelief;
    float3 nightColor =
      mix(float3(0.24, 0.27, 0.34), float3(0.38, 0.42, 0.50), puffHeight) *
      interiorRelief;
    float3 color = mix(nightColor, dayColor, dayFactor);
    opacity = clamp(opacity, 0.0, 1.0);
    material.baseColor = float4(clamp(color, 0.0, 1.0) * opacity, opacity);
  }
}
