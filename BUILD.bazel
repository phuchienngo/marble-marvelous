test_suite(
    name = "app_test",
    tests = [
        ":EarthLocationMathTest",
        ":FailureCleanupStackTest",
        ":FilamentCameraFramingTest",
        ":FilamentEarthAssetPathsTest",
        ":FilamentEarthMotionTest",
        ":FilamentG3dbEarthMeshTest",
        ":FilamentMaterialAssetPathsTest",
        ":FilamentMaterialSourceChecksumTest",
        ":FilamentSunDirectionTest",
        ":LocationFallbackTest",
        ":OpenWeatherCloudsTest",
        ":WallpaperLifecycleRegressionTest",
    ],
)
