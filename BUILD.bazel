kt_jvm_test(
    name = "OpenWeatherCloudsTest",
    srcs = ["test/weather/OpenWeatherCloudsTest.kt"],
    associates = [":app_lib"],
    test_class = "com.phuchienngo.marblemarvelous.weather.OpenWeatherCloudsTest",
    deps = _TEST_DEPS,
