<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />
    <uses-feature
        android:glEsVersion="0x30001"
        android:required="true" />

    <application
        android:name=".MarbleApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:testOnly="false"
        android:theme="@style/wallpapersTheme">


        <service
            android:name="com.phuchienngo.marblemarvelous.filament.FilamentWallpaperService"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            android:label="@string/globe_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/live_wallpaper_earth" />
        </service>

        <activity
            android:name="com.phuchienngo.marblemarvelous.permissions.PermissionsActivity"
            android:exported="true"
            android:label="@string/permissions_activity"
            android:theme="@style/Theme.Transparent" />
    </application>
</manifest>
